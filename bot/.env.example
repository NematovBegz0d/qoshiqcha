# ============================================================
# BOT / BACKEND .env.example
# Bu faylni nusxa oling: cp bot/.env.example bot/.env
# Keyin bot/.env ichidagi qiymatlarni to'ldiring.
# bot/.env faylini HECH QACHON gitga qo'shmang.
# ============================================================

# ----------------------------
# Telegram Bot
# ----------------------------
# @BotFather → /newbot yoki /mybots → API Token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Frontend Mini App URL (https bilan bo'lishi shart)
# Local test uchun ngrok ishlatiladi: ngrok http 5173
WEB_APP_URL=https://your-frontend.netlify.app

# Frontend originlari (CORS), vergul bilan ajrating
# Productionda faqat aniq domenni ko'rsating — "*" qabul qilinmaydi
# Local (development) originlar NODE_ENV=production bo'lmasa avtomatik qo'shiladi
CORS_ORIGIN=https://your-frontend.netlify.app

# ----------------------------
# Admin sozlamalari
# ----------------------------
# Admin xabarlar yuboriladigan Telegram guruh yoki kanal ID si
# Guruh ID ni olish: @userinfobot botiga guruhni forward qiling
# Guruh uchun minus bilan boshlanadi: -1001234567890
ADMIN_CHAT_ID=-1001234567890

# Admin huquqiga ega Telegram foydalanuvchi ID lari (vergul bilan)
# ID ni olish: @userinfobot botiga /start yuboring
# Bot status o'zgartirish faqat shu ID larga ruxsat beriladi
ADMIN_TELEGRAM_IDS=111111111,222222222

# ----------------------------
# Firebase Admin SDK
# ----------------------------
# Firebase Console → Project Settings → Service Accounts
# → Generate new private key → JSON faylni yuklab oling
# JSON faylni bitta qatorda yozing (newline o'rniga \n ishlatilsin)
# Muhim: bu ma'lumot MAXFIY. Hech kimga bermang.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id","private_key_id":"abc123","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com","client_id":"000000000000000000000","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your_project_id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# ----------------------------
# Server
# ----------------------------
PORT=3005

# NODE_ENV=production qiymati:
#   - Localhost originlar CORS ro'yxatidan chiqariladi
#   - CORS_ORIGIN="*" wildcard bloklangan
NODE_ENV=production

# API-only smoke/deploy uchun false qiling.
# Default: true
BOT_POLLING=true

# Server vaqt zonasi va pickup minimal tayyorlanish vaqti
APP_TIME_ZONE=Asia/Tashkent
MIN_PICKUP_LEAD_MINUTES=20

# ----------------------------
# Xavfsizlik sozlamalari
# ----------------------------
# Telegram initData qancha vaqt davomida yaroqli hisoblansin (soniyalarda).
# Default: 3600 (1 soat). Ko'proq oshirish replay attack oynasini kengaytiradi.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
